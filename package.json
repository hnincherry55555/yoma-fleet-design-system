{
  "name": "better-ds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run sync-tokens",
    "dev": "next dev",
    "prebuild": "npm run sync-tokens",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync-tokens": "tsx scripts/generate-tailwind-theme.ts",
    "presync-tokens": "echo 'Reading src/design/tokens.json...'",
    "validate:hex": "! grep -rn '#[0-9a-fA-F]\\{3,8\\}' src/components/ --include='*.tsx' --include='*.ts'",
    "validate:arbitrary": "! grep -rn '\\[#' src/components/ --include='*.tsx' --include='*.ts'",
    "validate:defaults": "! grep -rEn 'bg-(gray|slate|zinc)-[0-9]' src/components/ --include='*.tsx' --include='*.ts'",
    "validate": "npm run validate:hex && npm run validate:arbitrary && npm run validate:defaults",
    "ci": "npm run validate && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
